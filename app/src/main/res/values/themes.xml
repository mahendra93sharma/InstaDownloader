<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Minimal pre-Compose theme used only during the splash window before
        setContent inflates. Compose owns all real theming via ReelGrabTheme.
    -->
    <style name="Theme.ReelGrab" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
